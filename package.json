{
  "name": "dsh-focus-garden",
  "version": "0.1.0",
  "description": "番茄花园：把每段专注时间种成一朵花，支持暂停、恢复和收获的 DeepSeek Harness 趣味插件。",
  "type": "module",
  "license": "MIT",
  "author": "qinghuidaqzp",
  "repository": { "type": "git", "url": "git+https://github.com/qinghuidaqzp/dsh-focus-garden.git" },
  "homepage": "https://github.com/qinghuidaqzp/dsh-focus-garden#readme",
  "bugs": { "url": "https://github.com/qinghuidaqzp/dsh-focus-garden/issues" },
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "locale", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "keywords": ["dsh-plugin", "deepseek-harness", "pomodoro", "focus", "garden"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": { "@deepseek-ai/schemastery": "~3.19.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
